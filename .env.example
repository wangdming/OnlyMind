# Copy to .env and adjust, or export these before `npm start`.

# API access token. If unset, a random one is generated and printed at startup.
ONLYMIND_TOKEN=change-me-to-a-strong-secret

# Listen address/port. 0.0.0.0 is required so your LAN IP / cloudflared can reach it.
ONLYMIND_HOST=0.0.0.0
ONLYMIND_PORT=8787

# SQLite file location.
ONLYMIND_DB=./data/onlymind.db

# Default working directory for tasks that don't specify one.
ONLYMIND_DEFAULT_CWD=

# Per-task hard timeout in milliseconds (default 10 min).
ONLYMIND_TASK_TIMEOUT_MS=600000

# --- API engines (optional) -------------------------------------------------
# For the "openai" / "anthropic" engines. You can also set keys from the phone
# (gear → API Key), which stores them in the DB; these env vars are a fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Models used by the API engines (set to whatever your account supports).
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
